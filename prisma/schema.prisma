// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Incident {
  id           Int      @id @default(autoincrement())
  lat          Float
  lng          Float
  incidentType String
  severity     String
  description  String
  vesselName   String?
  vesselType   String?
  vesselFlag   String?
  occurredAt   DateTime
  reportedAt   DateTime @default(now())
  dataSource   String
}

model Vessel {
  id         Int      @id @default(autoincrement())
  mmsi       String   @unique
  name       String
  type       String
  flag       String
  lat        Float
  lng        Float
  speed      Float
  heading    Float
  isDark     Boolean
  riskScore  Float
  lastSeenAt DateTime
}

model RiskZone {
  id            Int    @id @default(autoincrement())
  name          String
  centerLat     Float
  centerLng     Float
  riskLevel     Float
  incidentCount Int
  trend         String
  zoneType      String
}

model Alert {
  id                Int      @id @default(autoincrement())
  severity          String
  title             String
  message           String
  isRead            Boolean  @default(false)
  relatedVesselMmsi String?
  relatedIncidentId Int?
  createdAt         DateTime @default(now())
}

model Detection {
  id              Int      @id @default(autoincrement())
  lat             Float
  lng             Float
  detectionType   String
  confidence      Float
  imageUrl        String?
  sceneId         String?
  vesselCount     Int
  darkVesselCount Int
  capturedAt      DateTime
  createdAt       DateTime @default(now())
}